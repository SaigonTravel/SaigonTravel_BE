{
  "name": "saigontravel-backend",
  "version": "1.0.0",
  "description": "Backend API for Saigon Travel - Travel, Teambuilding, Events & MICE",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:tours": "node src/seeds/tourSeeder.js",
    "seed:content": "node src/seeds/contentSeeder.js",
    "seed:admin": "node src/seeds/adminSeeder.js",
    "db:sync-indexes": "node src/seeds/syncIndexes.js",
    "seed:all": "node src/seeds/tourSeeder.js && node src/seeds/contentSeeder.js"
  },
  "keywords": [
    "saigontravel",
    "teambuilding",
    "travel",
    "express",
    "mongodb",
    "mongoose"
