PORT=5000
NODE_ENV=development
# Luôn ghi tên database trong URI, ví dụ Atlas: mongodb+srv://<user>:<pass>@<cluster>/saigontravel_db?appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/saigontravel_db
JWT_SECRET=saigontravel_super_secret_jwt_key_2026
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:3000

# Tài khoản admin tạo bởi: npm run seed:admin
ADMIN_EMAIL=admin@saigon-travel.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_please
ADMIN_NAME=Administrator
